{
  "name": "ai-engineering-handbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "build": "npm run check && vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "node scripts/check-content.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "gray-matter": "4.0.3",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.6"
  }
}
